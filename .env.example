# docker compose 용. 복사해서 사용: cp .env.example .env  (.env 는 커밋하지 않는다)
# 로컬 개발(./start.sh)은 이 파일이 아니라 BE-Agent/.env, FE-Agent/.env.local 을 쓴다.

# 필수. 생성: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# 설정 화면에 저장하는 API 키의 암호화 키. 비우면 JWT_SECRET 에서 만든다
ENCRYPTION_KEY=

# 사용자가 접속하는 주소 (CORS, 비밀번호 재설정 메일 링크)
PUBLIC_URL=http://localhost:3000
# 외부 서비스가 직접 부르는 백엔드 주소 ('API로 호출' 예시에 표시). 바꾸면 fe 이미지를 다시 빌드해야 한다
PUBLIC_API_URL=http://localhost:8000

# 모델. 서버 키를 넣으면 운영자 비용이 나가므로 CREDITS_ENFORCED=true 로 둔다
DEFAULT_MODEL=fake:echo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CREDITS_ENFORCED=true

# 첫 계정을 만든 뒤 false 로 바꾸면 개인용으로 쓸 수 있다
ALLOW_SIGNUP=true
ADMIN_EMAILS=[]

# 호스트에 여는 포트 (./start.sh 개발 서버와 동시에 띄우면 겹치니 바꾼다. PUBLIC_URL·PUBLIC_API_URL 도 함께)
BE_PORT=8000
FE_PORT=3000
